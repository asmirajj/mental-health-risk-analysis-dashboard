              <calculation class='tableau' formula='IF [History of Mental Illness] = &apos;Yes&apos; THEN 1 ELSE 0 END +&#13;&#10;IF [History of Substance Abuse] = &apos;Yes&apos; THEN 1 ELSE 0 END +&#13;&#10;IF [Family History of Depression] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
