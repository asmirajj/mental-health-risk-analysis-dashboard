            <column caption='Income group' datatype='string' name='[Calculation_1037516778941325312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Income] &lt; 30000 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Income] &gt;= 30000 AND [Income] &lt; 70000 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
            </column>
            <column caption='Age Group' datatype='string' name='[Calculation_1037516778941513729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Age] &lt; 20 THEN &quot;&lt;20&quot;&#13;&#10;ELSEIF [Age] &gt;= 20 AND [Age] &lt;= 40 THEN &quot;20–40&quot;&#13;&#10;ELSEIF [Age] &gt; 40 AND [Age] &lt;= 60 THEN &quot;41–60&quot;&#13;&#10;ELSE &quot;&gt;60&quot;&#13;&#10;END' />
