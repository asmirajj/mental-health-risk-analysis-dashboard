      <aliases enabled='yes' />
      <column caption='Income group' datatype='string' name='[Calculation_1037516778941325312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Income] &lt; 30000 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Income] &gt;= 30000 AND [Income] &lt; 70000 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1037516778941513729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 20 THEN &quot;&lt;20&quot;&#13;&#10;ELSEIF [Age] &gt;= 20 AND [Age] &lt;= 40 THEN &quot;20–40&quot;&#13;&#10;ELSEIF [Age] &gt; 40 AND [Age] &lt;= 60 THEN &quot;41–60&quot;&#13;&#10;ELSE &quot;&gt;60&quot;&#13;&#10;END' />
      </column>
      <column caption='Mental Health Risk' datatype='integer' name='[Calculation_1037516778941689858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [History of Mental Illness] = &apos;Yes&apos; THEN 1 ELSE 0 END +&#13;&#10;IF [History of Substance Abuse] = &apos;Yes&apos; THEN 1 ELSE 0 END +&#13;&#10;IF [Family History of Depression] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Count(Name)' datatype='integer' name='[Calculation_1037516778942906371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='X-Axis Field' datatype='real' name='[Calculation_1037516778958127110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Income&apos; THEN [Income]&#13;&#10;    WHEN &apos;Age&apos; THEN [Age]&#13;&#10;    WHEN &apos;Mental Health Risk&apos; THEN [Calculation_1037516778941689858]&#13;&#10;    WHEN &apos;Number of Children&apos; THEN [Number of Children]&#13;&#10;    // Add more fields as needed&#13;&#10;END' />
      </column>
      <column caption='Y-Axis Field' datatype='string' name='[Calculation_1037516778958573575]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Alcohol Consumption&apos; THEN [Alcohol Consumption]&#13;&#10;    WHEN &apos;Chronic Medical Conditions&apos; THEN [Chronic Medical Conditions]&#13;&#10;    WHEN &apos;Physical Activity Level&apos; THEN [Physical Activity Level]&#13;&#10;    WHEN &apos;Dietary Habits&apos; THEN [Dietary Habits]&#13;&#10;    WHEN &apos;Education Level&apos; THEN [Education Level]&#13;&#10;    WHEN &apos;Family History of Depression&apos; THEN [Family History of Depression]&#13;&#10;    WHEN &apos;History of Mental Illness&apos; THEN [History of Mental Illness]&#13;&#10;    WHEN &apos;History of Substance Abuse&apos; THEN [History of Substance Abuse]&#13;&#10;    WHEN &apos;Marital Status&apos; THEN [Marital Status]&#13;&#10;    WHEN &apos;Sleep Patterns&apos; THEN [Sleep Patterns]&#13;&#10;    WHEN &apos;Smoking Status&apos; THEN [Smoking Status]&#13;&#10; // Add more fields as needed&#13;&#10;END' />
      </column>
      <column caption='Row Index' datatype='integer' name='[Calculation_1037516778963578888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
